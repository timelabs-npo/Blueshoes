{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueshoes-spaceport",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "blueshoes.space/*",
      "zone_name": "blueshoes.space"
    }
  ],
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  }
}
